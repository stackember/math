---
/**
 * Заголовок Starlight + перехід між теорією й практикою теми.
 * Пара шукається за однаковою назвою файлу: theory/<slug> ↔ practice/<slug>.
 */
import { LinkButton } from "@astrojs/starlight/components"
import Default from "@astrojs/starlight/components/PageTitle.astro"
import { getCollection } from "astro:content"

import { describe, href, pairOf } from "@/lib/topics"

const { entry } = Astro.locals.starlightRoute
const page = describe(entry.id)

if (page.section && entry.data.sidebar.order === undefined) {
  throw new Error(`«${entry.id}»: додай sidebar.order у frontmatter (порядок теми, крок 10)`)
}

// getCollection замість getEntry: у теми може не бути практики, і getEntry засмічує лог попередженням
const pairId = page.section && pairOf(page.section, page.slug)
const [pair] = pairId ? await getCollection("docs", (doc) => doc.id === pairId) : []
const link =
  pair &&
  (page.section === "theory"
    ? { label: "🏋️ Практика", href: href(pair.id), variant: "primary" as const }
    : { label: "← Теорія", href: href(pair.id), variant: "secondary" as const })
---

<Default />
{link && (
  <nav class="pair" aria-label="Теорія і практика">
    <LinkButton href={link.href} variant={link.variant}>
      {link.label}
    </LinkButton>
  </nav>
)}

<style>
  .pair {
    margin-top: 1rem;
  }
  .pair :global(.sl-link-button) {
    margin: 0;
    padding: 0.4rem 0.9rem;
    font-size: var(--sl-text-sm);
  }
</style>
