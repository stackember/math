---
/**
 * Дві колонки Starlight: контент + «На цій сторінці».
 * Відмінність від стандартної: колонка змісту має фіксовану ширину,
 * а контент центрується у вільному місці. У стандартній зміст забирає
 * весь залишок ширини, а контент притискається до нього впритул.
 */
---

<div class="lg:sl-flex">
  {Astro.locals.starlightRoute.toc && (
    <aside class="right-sidebar-container print:hidden">
      <div class="right-sidebar">
        <slot name="right-sidebar" />
      </div>
    </aside>
  )}
  <div class="main-pane">
    <slot />
  </div>
</div>

<style>
  @layer starlight.core {
    .main-pane {
      isolation: isolate;
    }

    @media (min-width: 72rem) {
      .right-sidebar-container {
        /* Вужчий зміст на ноутбуках, стандартний (18.75rem) — на великих екранах.
           Змінна діє лише всередині колонки змісту: ліве меню не зачіпає. */
        --sl-sidebar-width: clamp(14rem, 18vw, 18.75rem);

        order: 2;
        position: relative;
        flex-shrink: 0;
        width: var(--sl-sidebar-width);
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        width: var(--sl-sidebar-width);
        height: 100vh;
        padding-top: var(--sl-nav-height);
        overflow-y: auto;
        scrollbar-width: none;
        border-inline-start: 1px solid var(--sl-color-hairline);
      }

      .main-pane {
        /* Більший відступ, щоб на ноутбуці контент не прилипав до змісту */
        --sl-content-pad-x: 2.5rem;

        order: 1;
        width: 100%;
        min-width: 0;
      }
    }
  }
</style>
