---
/**
 * Тренажер на сторінці practice/<slug>.mdx: бере `quiz` з frontmatter цієї сторінки,
 * рендерить формули під час збирання і віддає готові дані React-острову.
 */
import { getEntry } from "astro:content"

import { renderQuiz } from "@/lib/quiz/render"
import { storageKey } from "@/lib/quiz/storage"
import { describe, pairOf } from "@/lib/topics"

import Quiz from "./Quiz"

const { entry } = Astro.locals.starlightRoute
const page = describe(entry.id)

if (page.section !== "practice") {
  throw new Error(`«${entry.id}»: <Trainer /> має бути на сторінці practice/<slug>.mdx`)
}
if (!entry.data.quiz) {
  throw new Error(`«${entry.id}»: немає поля quiz у frontmatter`)
}
const theory = await getEntry("docs", pairOf("practice", page.slug))
if (!theory) {
  throw new Error(`«${entry.id}»: немає теорії theory/${page.slug}.md до цієї практики`)
}
if (theory.data.sidebar.order !== entry.data.sidebar.order) {
  throw new Error(
    `«${entry.id}»: sidebar.order має збігатися з теорією (${theory.data.sidebar.order}), щоб меню йшло в однаковому порядку`
  )
}

const quiz = await renderQuiz(entry.data.quiz)
---

<div class="not-content mt-8">
  <Quiz client:only="react" quiz={quiz} storageKey={storageKey(entry.id)}>
    <p slot="fallback" class="text-muted-foreground">
      Завантаження тренажера…
    </p>
  </Quiz>
</div>
