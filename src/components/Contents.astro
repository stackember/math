---
/** Зміст курсу для головної: теми з реєстру + уроки й тренажери з найкращими результатами. */
import { href, menuLabel, topicId, topicLessons } from "@/lib/content"
import { storageKey } from "@/lib/quiz/storage"
import { books } from "@/navigation"

const contents = await Promise.all(
  books
    .filter((book) => book.topics.length > 0)
    .map(async (book) => ({
      book,
      topics: await Promise.all(
        book.topics.map(async (topic) => ({
          topic,
          lessons: await topicLessons(book.dir, topic.slug),
        }))
      ),
    }))
)
---

{contents.map(({ book, topics }) => (
  <>
    <h3>{book.label}</h3>
    <ul>
      {topics.map(({ topic, lessons }) => (
        <li>
          <a href={href(topicId(book.dir, topic.slug))}>📘 {topic.label}</a>
          {lessons.length > 0 && (
            <ul>
              {lessons.map(({ lesson, trainer }) => (
                <li>
                  <a href={href(lesson.id)}>🧠 {menuLabel(lesson)}</a>
                  {trainer && (
                    <>
                      {" · "}
                      <a href={href(trainer.id)}>🏋️ тренажер</a>
                      <span class="stats" data-trainer-stats={storageKey(trainer.id)} />
                    </>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </>
))}

<script>
  import { loadStats } from "@/lib/quiz/storage"

  for (const el of document.querySelectorAll<HTMLElement>("[data-trainer-stats]")) {
    const { best } = loadStats(el.dataset.trainerStats ?? "")
    if (best) el.textContent = ` — найкраще ${best.score}/${best.total}`
  }
</script>

<style>
  .stats {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
